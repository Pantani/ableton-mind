{
  "name": "ableton-mind",
  "version": "0.1.0",
  "mcpName": "io.github.Pantani/ableton-mind",
  "description": "Definitive MCP server for Ableton Live: complete LOM coverage, embedded knowledge base and music recipes.",
  "license": "MIT",
  "homepage": "https://pantani.github.io/ableton-mind/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pantani/ableton-mind.git"
  },
  "bugs": {
    "url": "https://github.com/Pantani/ableton-mind/issues"
  },
  "author": "Pantani",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ableton-mind": "dist/index.js",
    "ableton-mind-doctor": "dist/cli/doctor.js",
    "ableton-mind-install-remote-script": "scripts/install-remote-script.mjs"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "recipes",
    "live/AbletonMind/*.py",
    "live/AbletonMind/handlers/*.py",
    "live/AbletonMind/README.md",
    "scripts/install-remote-script.mjs",
    "src/knowledge/devices",
    "src/knowledge/scales.json",
    "server.json",
    "dxt/manifest.json",
    "safeskill.manifest.json",
    "smithery.yaml",
    "glama.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "deps:validate": "depcruise --config .dependency-cruiser.cjs src tests scripts",
    "deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot src | dot -T svg > docs/dependency-graph.svg",
    "complexity": "eslint --config eslint.config.js \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,cjs,ts}\"",
    "complexity:all": "eslint --config eslint.config.js --rule \"{\\\"complexity\\\":[\\\"warn\\\",1]}\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs,cjs,ts}\"",
    "complexity:py": "ruff check --select C901 --statistics live/AbletonMind",
    "test": "vitest run",
    "validate:recipes": "vitest run tests/phase5-6-recipes.test.ts",
    "test:watch": "vitest",
    "install:remote-script": "node scripts/install-remote-script.mjs",
    "extract:devices": "node scripts/extract-device-schemas.mjs",
    "build:dxt": "node scripts/build-dxt.mjs",
    "build:dxt:check": "node scripts/build-dxt.mjs --check",
    "build:mcpb": "node scripts/build-dxt.mjs",
    "lint:py": "uvx ruff check live/AbletonMind",
    "lint:py:fix": "uvx ruff check live/AbletonMind --fix-only",
    "test:bridge": "python3 -m unittest discover -s live/AbletonMind/tests -t live -v",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "version": "node scripts/sync-manifest-version.mjs && git add dxt/manifest.json server.json safeskill.manifest.json",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run test:bridge && npm run docs:build && npm run build && npm run build:dxt:check && npm audit --omit=dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.14.10",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^9.15.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^7.3.5"
  },
  "keywords": [
    "mcp",
    "ableton",
    "ableton-live",
    "music",
    "llm",
    "claude",
    "model-context-protocol"
  ]
}
