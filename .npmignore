# Files ignored by `npm publish`.
# `files` in package.json is already the primary whitelist; this is extra defense.

# Source maps + dev configs
*.map
.DS_Store
.editorconfig
.env*

# Non-distributed build artifacts
build/
coverage/
.tsbuildinfo

# Test files
tests/
vitest.config.ts
*.test.ts
*.test.js
*.spec.ts
*.spec.js

# Source non-compiled
src/

# Dev tooling
.github/
.husky/
biome.json
tsconfig.json
tsup.config.ts
.dependency-cruiser.cjs

# Live bridge: distributed through scripts/install-remote-script.mjs after install
live/

# Workspace + ADRs (internal)
_workspace/

# Recipes: duplicated in dist/? Recipes live in `recipes/` next to `dist/`.
# Commented out: recipes should be distributed.
# recipes/

# Docs: README is the only file distributed by package.json::files
docs/
PLAN.md
CLAUDE.md
AGENTS.md
CHANGELOG.md

# Scripts dev
scripts/build-dxt.mjs
scripts/install-remote-script.mjs
scripts/extract-device-schemas.mjs

# Logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
