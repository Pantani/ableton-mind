{
  "$schema": "../device-schema.json",
  "id": "ableton.scale",
  "name": "Scale",
  "category": "midi_effect",
  "vendor": "Ableton",
  "live_version_min": "8.0",
  "description": "MIDI effect: forces notes into a defined scale. A 12-cell grid configures each pitch class.",
  "source": "curated (Cycle 17)",
  "completeness": "complete",
  "parameters": [
    {
      "index": 0,
      "name": "Base",
      "min": 0,
      "max": 11,
      "default": 0,
      "unit": "MIDI",
      "automatable": true,
      "modulatable": true,
      "description": "Tonic (C=0, C#=1, ...)."
    },
    {
      "index": 1,
      "name": "Transpose",
      "min": -36,
      "max": 36,
      "default": 0,
      "unit": "semitones",
      "automatable": true
    },
    {
      "index": 2,
      "name": "Range Lower",
      "min": 0,
      "max": 127,
      "default": 0,
      "unit": "MIDI",
      "automatable": true
    },
    {
      "index": 3,
      "name": "Range Upper",
      "min": 0,
      "max": 127,
      "default": 127,
      "unit": "MIDI",
      "automatable": true
    },
    {
      "index": 4,
      "name": "Fold",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "bool",
      "automatable": false
    },
    {
      "index": 5,
      "name": "Out of Range Mode",
      "min": 0,
      "max": 2,
      "default": 0,
      "unit": "enum",
      "automatable": false,
      "description": "Lowest / Nearest / Block."
    }
  ],
  "todo": [
    "The grid's 12 cells (pitch class to output class) are editable in the UI but not exposed as individual params. Phase 8 can expose them through the LOM (`scale_map`)."
  ]
}
