{
  "$schema": "../device-schema.json",
  "id": "ableton.vinyl_distortion",
  "name": "Vinyl Distortion",
  "category": "audio_effect",
  "vendor": "Ableton",
  "live_version_min": "8.0",
  "description": "Vinyl-style distortion: tracing distortion + crackle simulation. Models mechanical turntable imperfections.",
  "source": "curated (Cycle 13)",
  "completeness": "complete",
  "parameters": [
    {
      "index": 0,
      "name": "Tracing Freq",
      "min": 1,
      "max": 22000,
      "default": 6000,
      "unit": "Hz",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 1,
      "name": "Tracing Drive",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "linear",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 2,
      "name": "Tracing Stereo",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "linear",
      "automatable": true
    },
    {
      "index": 3,
      "name": "Pinch Freq",
      "min": 1,
      "max": 22000,
      "default": 1500,
      "unit": "Hz",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 4,
      "name": "Pinch Drive",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "linear",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 5,
      "name": "Pinch Stereo",
      "min": 0,
      "max": 1,
      "default": 1,
      "unit": "linear",
      "automatable": true
    },
    {
      "index": 6,
      "name": "Crackle Density",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "unit": "linear",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 7,
      "name": "Crackle Volume",
      "min": -70,
      "max": 12,
      "default": -36,
      "unit": "dB",
      "automatable": true,
      "modulatable": true
    }
  ],
  "todo": []
}
