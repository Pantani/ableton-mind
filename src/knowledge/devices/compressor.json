{
  "$schema": "../device-schema.json",
  "id": "ableton.compressor",
  "name": "Compressor",
  "category": "audio_effect",
  "vendor": "Ableton",
  "live_version_min": "9.0",
  "description": "Compressor with 3 detection modes (Peak, RMS, Expand), internal/external sidechain, adjustable knee, lookahead, and auto makeup gain.",
  "source": "curated (Cycle 6)",
  "completeness": "complete",
  "parameters": [
    {
      "index": 0,
      "name": "Threshold",
      "min": -70,
      "max": 0,
      "default": -20,
      "unit": "dB",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 1,
      "name": "Ratio",
      "min": 1,
      "max": 100,
      "default": 4,
      "unit": ":1",
      "automatable": true,
      "modulatable": true,
      "description": "1=no compression, ∞=brick wall."
    },
    {
      "index": 2,
      "name": "Attack",
      "min": 0.01,
      "max": 300,
      "default": 1,
      "unit": "ms",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 3,
      "name": "Release",
      "min": 1,
      "max": 3000,
      "default": 50,
      "unit": "ms",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 4,
      "name": "Knee",
      "min": 0,
      "max": 18,
      "default": 6,
      "unit": "dB",
      "automatable": true,
      "modulatable": true,
      "description": "0=hard knee, 18=soft knee."
    },
    {
      "index": 5,
      "name": "Output Gain",
      "min": -36,
      "max": 36,
      "default": 0,
      "unit": "dB",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 6,
      "name": "Dry/Wet",
      "min": 0,
      "max": 1,
      "default": 1,
      "unit": "linear",
      "automatable": true,
      "modulatable": true,
      "description": "Parallel compression."
    },
    {
      "index": 7,
      "name": "Auto Release",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "bool",
      "automatable": true,
      "description": "Release adaptativo ao programa."
    },
    {
      "index": 8,
      "name": "Auto Makeup",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "bool",
      "automatable": false
    },
    {
      "index": 9,
      "name": "Lookahead",
      "min": 0,
      "max": 2,
      "default": 0,
      "unit": "enum",
      "automatable": false,
      "description": "0=Off, 1=1ms, 2=10ms."
    },
    {
      "index": 10,
      "name": "Model",
      "min": 0,
      "max": 2,
      "default": 0,
      "unit": "enum",
      "automatable": false,
      "description": "0=Peak, 1=RMS, 2=Expand."
    },
    {
      "index": 11,
      "name": "Envelope",
      "min": 0,
      "max": 2,
      "default": 0,
      "unit": "enum",
      "automatable": false,
      "description": "0=Lin, 1=Log, 2=Smoothed."
    },
    {
      "index": 12,
      "name": "Sidechain On",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "bool",
      "automatable": false,
      "description": "Ativa external/EQ sidechain."
    },
    {
      "index": 13,
      "name": "Sidechain Gain",
      "min": -36,
      "max": 36,
      "default": 0,
      "unit": "dB",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 14,
      "name": "Sidechain Mix",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "linear",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 15,
      "name": "Sidechain Listen",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "bool",
      "automatable": false,
      "description": "Solo o sinal de sidechain."
    },
    {
      "index": 16,
      "name": "EQ On",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "bool",
      "automatable": false,
      "description": "EQ no sidechain interno."
    },
    {
      "index": 17,
      "name": "EQ Type",
      "min": 0,
      "max": 3,
      "default": 3,
      "unit": "enum",
      "automatable": false,
      "description": "0=LowCut, 1=Bell, 2=HighCut, 3=Bell48."
    },
    {
      "index": 18,
      "name": "EQ Frequency",
      "min": 30,
      "max": 22000,
      "default": 200,
      "unit": "Hz",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 19,
      "name": "EQ Q",
      "min": 0.5,
      "max": 8,
      "default": 1,
      "unit": "Q",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 20,
      "name": "EQ Gain",
      "min": -15,
      "max": 15,
      "default": 0,
      "unit": "dB",
      "automatable": true,
      "modulatable": true
    }
  ],
  "todo": []
}
