    {
      "index": 9,
      "name": "Output",
      "min": -36,
      "max": 36,
      "default": 0,
      "unit": "dB",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 10,
      "name": "Dry/Wet",
      "min": 0,
      "max": 1,
      "default": 1,
      "unit": "linear",
      "automatable": true,
      "modulatable": true
    }
