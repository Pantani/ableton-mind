      "name": "Decay",
      "min": 0,
      "max": 60,
      "default": 5,
      "unit": "s",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 2,
      "name": "Decay Bias",
      "min": -1,
      "max": 1,
      "default": 0,
      "unit": "linear",
      "automatable": true
    },
    {
      "index": 3,
      "name": "Inharmonics",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "linear",
      "automatable": true,
      "modulatable": true
    },
    {
      "index": 4,
      "name": "MIDI",
      "min": 0,
      "max": 1,
      "default": 0,
      "unit": "bool",
      "automatable": false,
      "description": "Sidechain MIDI → frequência."
    },
    {
      "index": 5,
      "name": "Note",
      "min": 0,
      "max": 127,
      "default": 60,
      "unit": "MIDI",
      "automatable": true,
      "modulatable": true
    },
    {
