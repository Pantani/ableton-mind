{
  "$schema": "../device-schema.json",
  "id": "ableton.spectral_resonator",
  "name": "Spectral Resonator",
  "category": "audio_effect",
  "vendor": "Ableton",
  "live_version_min": "11.0",
  "description": "Resonator espectral via FFT. Cria harmonias / drones / texturas pitched a partir de qualquer áudio.",
  "source": "curated (Cycle 12)",
