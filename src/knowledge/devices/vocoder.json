{
  "$schema": "../device-schema.json",
  "id": "ableton.vocoder",
  "name": "Vocoder",
  "category": "audio_effect",
  "vendor": "Ableton",
  "live_version_min": "9.0",
  "description": "Vocoder com 4 modos de carrier (Noise / Modulator / Pitch Tracking / External) + bands ajustáveis.",
  "source": "curated (Cycle 10)",
  "completeness": "complete",
  "parameters": [
    { "index": 0,  "name": "Carrier Type", "min": 0, "max": 3, "default": 0, "unit": "enum", "automatable": false, "description": "Noise / Modulator / Pitch Tracking / External." },
    { "index": 1,  "name": "Bands", "min": 4, "max": 40, "default": 12, "unit": "count", "automatable": false },
    { "index": 2,  "name": "Range Bottom", "min": 50, "max": 16000, "default": 80, "unit": "Hz", "automatable": true, "modulatable": true },
    { "index": 3,  "name": "Range Top", "min": 200, "max": 22000, "default": 8000, "unit": "Hz", "automatable": true, "modulatable": true },
    { "index": 4,  "name": "BW", "min": 0.1, "max": 4, "default": 1, "unit": "octaves", "automatable": true, "modulatable": true },
    { "index": 5,  "name": "Gate", "min": -96, "max": 0, "default": -96, "unit": "dB", "automatable": true },
    { "index": 6,  "name": "Level", "min": -36, "max": 36, "default": 0, "unit": "dB", "automatable": true, "modulatable": true },
    { "index": 7,  "name": "Formant", "min": -12, "max": 12, "default": 0, "unit": "semitones", "automatable": true, "modulatable": true },
    { "index": 8,  "name": "Attack", "min": 0.1, "max": 100, "default": 1, "unit": "ms", "automatable": true },
    { "index": 9,  "name": "Release", "min": 1, "max": 1000, "default": 10, "unit": "ms", "automatable": true },
    { "index": 10, "name": "Enhance", "min": 0, "max": 1, "default": 0.4, "unit": "linear", "automatable": true, "modulatable": true },
    { "index": 11, "name": "Unvoiced Sens", "min": 0, "max": 1, "default": 0.5, "unit": "linear", "automatable": true },
    { "index": 12, "name": "Unvoiced Level", "min": -36, "max": 0, "default": -12, "unit": "dB", "automatable": true },
    { "index": 13, "name": "Pitch Tracking Note", "min": 24, "max": 96, "default": 60, "unit": "MIDI", "automatable": false },
    { "index": 14, "name": "Mono/Stereo", "min": 0, "max": 1, "default": 1, "unit": "enum", "automatable": false },
    { "index": 15, "name": "Dry/Wet", "min": 0, "max": 1, "default": 1, "unit": "linear", "automatable": true, "modulatable": true }
  ],
  "todo": []
}
