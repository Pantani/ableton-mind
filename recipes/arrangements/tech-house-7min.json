{
  "$schema": "../recipe-schema.json",
  "id": "arrangements/tech-house-7min",
  "name": "Tech-House 7-Min Arrangement",
  "category": "arrangements",
  "version": "0.1",
  "description": "Cria scaffold de arranjo tech-house 7 minutos: 4 cenas (Intro / Drop / Break / Outro) com locators. Não cria devices — assume kit já carregado em outra recipe (tech-house-kick + sub-808 + …).",
  "tags": ["tech-house", "arrangement", "7-min", "intro-drop-break-outro"],
  "inputs": {
    "tempo": { "type": "number", "default": 126, "min": 110, "max": 140 }
  },
  "steps": [
    { "op": "transport.set_tempo", "args": { "bpm": "{{tempo}}" } },
    { "op": "track.upsert", "args": { "name": "Intro", "type": "midi" }, "let": "intro_scene_setup" },
    { "op": "clip.create_midi", "args": { "track_index": "{{intro_scene_setup.track.index}}", "clip_slot_index": 0, "length_beats": 32.0, "name": "Intro 8bar" } },
    { "op": "clip.create_midi", "args": { "track_index": "{{intro_scene_setup.track.index}}", "clip_slot_index": 1, "length_beats": 64.0, "name": "Drop 16bar" } },
    { "op": "clip.create_midi", "args": { "track_index": "{{intro_scene_setup.track.index}}", "clip_slot_index": 2, "length_beats": 32.0, "name": "Break 8bar" } },
    { "op": "clip.create_midi", "args": { "track_index": "{{intro_scene_setup.track.index}}", "clip_slot_index": 3, "length_beats": 32.0, "name": "Outro 8bar" } }
  ]
}
